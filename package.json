{
  "name": "rhiva-web",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi",
    "lint": "bun x biome format --write && bun x biome lint --fix && biome check .",
    "clean": "rimraf node_modules .turbo out && turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tsconfig/bun": "^1.0.10",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.5"
  },
  "workspaces": [
    "ui/*",
    "apps/*",
    "packages/*"
  ]
}

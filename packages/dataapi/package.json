{
  "name": "@rhivadotfun/dataapi",
  "version": "1.0.0",
  "description": "SDK client for Rhiva data API",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format=esm,cjs --minify --treeshake"
  },
  "dependencies": {
    "xior": "^0.7.7"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    }
  }
}
